function toast(m){var t=$("toast");t.textContent=m;t.style.display="block";clearTimeout(toast.h);toast.h=setTimeout(function(){t.style.display="none";},1800);}
function cats(){var c=[];S.items.forEach(function(i){if(i.cat&&c.indexOf(i.cat)<0)c.push(i.cat);});return c;}
function low(i){return i.stock>0&&i.stock<=i.min;}
function byId(id){return S.items.filter(function(i){return i.id==id;})[0];}

function filtered(){
  return S.items.filter(function(i){
    var okq=!q||i.name.toLowerCase().indexOf(q.toLowerCase())>=0;
    var okc=cat==="Todos"||i.cat===cat;
    return okq&&okc;
  });
}

function viewInv(){
  var h='<input class="search" id="q" placeholder="Buscar producto" value="'+esc(q)+'">';
  h+='<div class="chips">';
  ["Todos"].concat(cats()).forEach(function(c){h+='<button class="chip'+(c===cat?" on":"")+'" data-cat="'+esc(c)+'">'+esc(c)+'</button>';});
  return h+'</div><div id="list">'+listHtml()+'</div>';
}
function listHtml(){
  var list=filtered();
  var h="";
  if(!list.length)h+='<div class="empty">Aún no hay productos aquí.<br>Toca + para agregar el primero.</div>';
  list.forEach(function(i){
    var tag=i.stock===0?'<span class="tag out">Agotado</span>':(low(i)?'<span class="tag">Poco stock</span>':"");
    h+='<div class="row" data-open="'+i.id+'"><div class="em">'+ico(i)+'</div><div class="info"><b>'+esc(i.name)+'</b><small>'+fmt(i.price)+(i.cat?" · "+esc(i.cat):"")+'</small>'+tag+'</div><div class="qty"><button data-dec="'+i.id+'" aria-label="Restar una unidad">−</button><span>'+i.stock+'</span><button data-inc="'+i.id+'" aria-label="Sumar una unidad">+</button></div></div>';
  });
  return h;
}

function catText(){
  var t="*"+S.name+"*\nCatálogo de productos\n\n";
  S.items.filter(function(i){return i.show!==false&&i.stock>0;}).forEach(function(i){t+=(i.em||"•")+" "+i.name+": "+fmt(i.price)+"\n";});
  return t+"\n¿Quieres hacer un pedido? Escríbenos.";
}
function waLink(i){
  var n=(S.wa||"").replace(/\D/g,"");
  if(!n)return "";
  return "https://wa.me/"+n+"?text="+encodeURIComponent("Hola, quiero pedir: "+i.name+" ("+fmt(i.price)+")");
}
function gridHtml(){
  var list=S.items.filter(function(i){
    return i.show!==false&&(cat==="Todos"||i.cat===cat)&&(!q||i.name.toLowerCase().indexOf(q.toLowerCase())>=0);
  });
  if(!list.length)return '<div class="empty">No hay productos para mostrar.</div>';
  var h='<div class="grid">';
  list.forEach(function(i){
    var l=waLink(i);
    h+='<div class="card'+(i.stock===0?" sold":"")+'" data-det="'+i.id+'"><div class="big">'+ico(i)+'</div><b>'+esc(i.name)+'</b><div class="pr">'+fmt(i.price)+'</div><small>'+(i.stock===0?"Agotado":"Disponible")+(i.desc?" · Ver notas":"")+'</small>'+(l&&i.stock>0?'<a class="btn" target="_blank" rel="noopener" href="'+l+'">Pedir por WhatsApp</a>':"")+'</div>';
  });
  return h+'</div>';
}
function viewCat(){
  var h="";
  if(OWNER)h+='<div class="note">Así ven tu catálogo tus clientes: solo pueden mirar y pedir, no editar. Para compartirlo, usa el botón Compartir de esta página y deja el enlace visible para cualquiera.</div>';
  h+='<input class="search" id="cq" placeholder="Buscar en el catálogo" value="'+esc(q)+'"><div class="chips">';
  ["Todos"].concat(cats()).forEach(function(c){h+='<button class="chip'+(c===cat?" on":"")+'" data-cat="'+esc(c)+'">'+esc(c)+'</button>';});
  h+='</div><div id="cgrid">'+gridHtml()+'</div>';
  if(OWNER)h+='<a class="btn alt" target="_blank" rel="noopener" href="https://wa.me/?text='+encodeURIComponent(catText())+'">Enviar lista de precios por WhatsApp</a><button class="btn alt" id="copy">Copiar lista de precios</button>';
  return h;
}
function viewCatOld(){
  var list=S.items.filter(function(i){return i.show!==false;});
  var h='<div class="grid">';
  list.forEach(function(i){
    h+='<div class="card'+(i.stock===0?" sold":"")+'"><div class="big">'+esc(i.em||"📦")+'</div><b>'+esc(i.name)+'</b><div class="pr">'+fmt(i.price)+'</div><small>'+(i.stock===0?"Agotado":"Disponible")+'</small></div>';
  });
  h+='</div>';
  if(!list.length)h='<div class="empty">Tu catálogo está vacío.<br>Agrega productos y márcalos para mostrarlos.</div>';
  else{
    h+='<a class="btn" target="_blank" rel="noopener" href="https://wa.me/?text='+encodeURIComponent(catText())+'">Compartir por WhatsApp</a>';
    h+='<button class="btn alt" id="copy">Copiar lista de precios</button>';
  }
  return h;
}

function viewRes(){
  var u=0,cost=0,sale=0,out=[],lw=[];
  S.items.forEach(function(i){u+=i.stock;cost+=i.stock*i.cost;sale+=i.stock*i.price;if(i.stock===0)out.push(i);else if(low(i))lw.push(i);});
  var h='<div class="stats"><div class="stat"><small>Productos</small><b>'+S.items.length+'</b></div><div class="stat"><small>Unidades</small><b>'+u+'</b></div><div class="stat"><small>Inversión en stock</small><b>'+fmt(cost)+'</b></div><div class="stat"><small>Ganancia estimada</small><b>'+fmt(sale-cost)+'</b></div></div>';
  h+='<h2>Por reponer</h2>';
  var need=out.concat(lw);
  if(!need.length)h+='<div class="empty">Todo en orden. Ningún producto con poco stock.</div>';
  need.forEach(function(i){h+='<div class="row" data-open="'+i.id+'"><div class="em">'+ico(i)+'</div><div class="info"><b>'+esc(i.name)+'</b><small>Quedan '+i.stock+' (mínimo '+i.min+')</small></div></div>';});
  h+='<h2>Mi negocio</h2><label class="f">Nombre de la tienda<input id="sname" value="'+esc(S.name)+'"></label><label class="f">WhatsApp para pedidos (con código de país)<input id="swa" inputmode="tel" placeholder="573001234567" value="'+esc(S.wa)+'"></label>';
  return h;
}

function render(){
  $("ttl").innerHTML=S.logo?'<img class="logo" src="'+esc(S.logo)+'" alt="'+esc(S.name)+'">':'<span>'+esc(S.name)+'</span>';
  document.title=S.name;
  $("sub").textContent=!OWNER?"Catálogo de productos":tab==="inv"?"Controla lo que tienes en stock":tab==="cat"?"Lo que verán tus clientes":"Cómo va tu inventario";
  $("fab").style.display=(OWNER&&tab==="inv")?"block":"none";
  document.querySelector("nav").style.display=OWNER?"flex":"none";
  var a=$("app");
  a.innerHTML=!OWNER?viewCat():bar()+(tab==="inv"?viewInv():tab==="cat"?viewCat():viewRes());
  document.querySelectorAll("nav button").forEach(function(b){b.classList.toggle("on",b.dataset.t===tab);});
  var qi=$("q");
  if(qi)qi.addEventListener("input",function(){q=qi.value;$("list").innerHTML=listHtml();});
  var sn=$("sname");
  if(sn)sn.addEventListener("change",function(){S.name=sn.value.trim()||"Mi tienda";save();render();});
  var cq=$("cq");if(cq)cq.addEventListener("input",function(){q=cq.value;$("cgrid").innerHTML=gridHtml();});
  var sw=$("swa");if(sw)sw.addEventListener("change",function(){S.wa=sw.value.replace(/\D/g,"");save();render();toast("WhatsApp guardado");});
  var cp=$("copy");
  if(cp)cp.addEventListener("click",function(){
    try{navigator.clipboard.writeText(catText()).then(function(){toast("Lista copiada");},function(){toast("No se pudo copiar");});}catch(e){toast("No se pudo copiar");}
  });
}

function openForm(id){
  var i=id?byId(id):{id:0,em:"📦",name:"",cat:"",price:"",cost:"",stock:0,min:3,show:true};
  var h='<h3>'+(id?"Editar producto":"Nuevo producto")+'</h3>';
  var img=i.img||"";
  h+='<div class="two"><label class="f">Emoji<input id="fe" value="'+esc(i.em)+'" maxlength="4"></label><label class="f">Categoría<input id="fc" list="cl" value="'+esc(i.cat)+'"><datalist id="cl">'+cats().map(function(c){return '<option value="'+esc(c)+'">';}).join("")+'</datalist></label></div>';
  h+='<label class="f">Nombre<input id="fn" value="'+esc(i.name)+'" placeholder="Ej: Gaseosa 1.5 L"></label>';
  h+='<label class="f">Notas y descripción (opcional)<textarea id="fd" placeholder="Ej: Salida: bergamota. Corazón: jazmín. Fondo: ámbar y vainilla.">'+esc(i.desc||"")+'</textarea></label>';
  h+='<div class="two"><label class="f">Precio de venta<input id="fp" type="number" inputmode="decimal" min="0" value="'+esc(i.price)+'"></label><label class="f">Costo<input id="fk" type="number" inputmode="decimal" min="0" value="'+esc(i.cost)+'"></label></div>';
  h+='<div class="two"><label class="f">Unidades en stock<input id="fs" type="number" inputmode="numeric" min="0" value="'+esc(i.stock)+'"></label><label class="f">Avisar si quedan<input id="fm" type="number" inputmode="numeric" min="0" value="'+esc(i.min)+'"></label></div>';
  h+='<label class="chk"><input type="checkbox" id="fv"'+(i.show!==false?" checked":"")+'> Mostrar en el catálogo</label>';
  h+='<button class="btn" id="fsave">Guardar producto</button>';
  if(id)h+='<button class="btn del" id="fdel">Eliminar producto</button>';
  h+='<button class="btn alt" id="fcancel">Cancelar</button>';
  $("sheet").innerHTML=h;
  $("bg").classList.add("open");
  $("fcancel").onclick=closeForm;
  $("fsave").onclick=function(){
    var name=$("fn").value.trim();
    if(!name){toast("Escribe el nombre del producto");$("fn").focus();return;}
    var o=id?byId(id):{id:Date.now()};
    o.em=$("fe").value.trim()||"📦";o.name=name;o.cat=$("fc").value.trim();
    o.price=Math.max(0,+$("fp").value||0);o.cost=Math.max(0,+$("fk").value||0);
    o.stock=Math.max(0,Math.floor(+$("fs").value||0));o.min=Math.max(0,Math.floor(+$("fm").value||0));
    o.show=$("fv").checked;o.img=img;o.desc=$("fd").value.trim();
    if(!id)S.items.unshift(o);
    save();closeForm();render();toast("Producto guardado");
  };
  if(id)$("fdel").onclick=function(){
    if($("fdel").dataset.sure){S.items=S.items.filter(function(x){return x.id!=id;});save();closeForm();render();toast("Producto eliminado");}
    else{$("fdel").dataset.sure=1;$("fdel").textContent="Toca otra vez para confirmar";}
  };
}
function openDet(id){
  var i=byId(id);if(!i)return;
  var l=waLink(i);
  var im=(i.imgs&&i.imgs.length)?i.imgs:(i.img?[i.img]:[]);
  var h=im.length>1?'<div class="gal" id="gal">'+im.map(function(u){return '<img class="gi" src="'+esc(u)+'" alt="">';}).join("")+'</div><div class="dots">'+im.map(function(u,k){return '<i'+(k?"":' class="on"')+'></i>';}).join("")+'</div>':im.length?'<img class="dimg" src="'+esc(im[0])+'" alt="">':'<div style="text-align:center;font-size:80px">'+esc(i.em||"🧴")+'</div>';
  h+='<h3 style="margin:12px 0 2px">'+esc(i.name)+'</h3><div style="color:var(--brand);font-weight:800;font-size:22px">'+fmt(i.price)+'</div><small style="color:var(--mut)">'+(i.stock===0?"Agotado":"Disponible")+'</small>';
  if(i.desc)h+='<h2>Notas y descripción</h2><div class="dd">'+esc(i.desc)+'</div>';
  if(l&&i.stock>0)h+='<a class="btn" target="_blank" rel="noopener" href="'+l+'">Pedir por WhatsApp</a>';
  h+='<button class="btn alt" id="dclose">Cerrar</button>';
  $("sheet").innerHTML=h;$("bg").classList.add("open");$("dclose").onclick=closeForm;
  var g=$("gal");if(g)g.addEventListener("scroll",function(){var k=Math.round(g.scrollLeft/g.clientWidth);document.querySelectorAll(".dots i").forEach(function(x,j){x.classList.toggle("on",j===k);});});
}
function closeForm(){$("bg").classList.remove("open");}

document.addEventListener("click",function(e){
  var t=e.target;
  if(t===$("bg")){closeForm();return;}
  if(t.id==="pub"){publish();return;}
  var dc=t.closest("[data-det]");
  if(dc&&!t.closest("a")){openDet(dc.dataset.det);return;}
  if(!OWNER&&!t.closest("[data-cat]"))return;
  var b=t.closest("[data-inc],[data-dec],[data-cat],[data-open],[data-t]");
  if(!b)return;
  if(b.dataset.inc){var p=byId(b.dataset.inc);p.stock++;save();render();return;}
  if(b.dataset.dec){var p2=byId(b.dataset.dec);if(p2.stock>0)p2.stock--;save();render();return;}
  if(b.dataset.cat){cat=b.dataset.cat;render();return;}
  if(b.dataset.t){tab=b.dataset.t;render();window.scrollTo(0,0);return;}
  if(b.dataset.open){openForm(b.dataset.open);}
});
$("fab").addEventListener("click",function(){openForm(0);});
(function(){var s=document.getElementById("splash");if(!s)return;var h=function(){s.classList.add("out");setTimeout(function(){s.remove();},600);};s.addEventListener("click",h);setTimeout(h,3000);})();
load();render();
(async function(){
  try{
    var u=await claude.use("user");
    if(u&&u.isOwner()){
      OWNER=true;tab="inv";
      var dr=null;try{dr=localStorage.getItem(KEY);}catch(e){}
      if(dr&&dr!==JSON.stringify(S)){try{S=JSON.parse(dr);dirty=true;}catch(e){}}
      render();
    }
  }catch(e){}
})();
</script></body></html>
