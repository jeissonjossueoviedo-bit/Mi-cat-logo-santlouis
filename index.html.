<!doctype html>
<html lang="es" data-theme="light" style="color-scheme: light;"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sant Louis Perfumes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&amp;family=Cormorant+Garamond:wght@600;700&amp;display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f6f4;--card:#fff;--ink:#12231b;--mut:#5d6f66;--line:#dce5e0;--brand:#0f7a55;--on:#fff;--accent:#f2a516;--warn:#b45309;--warnbg:#fef0d6;--bad:#b42318;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1511;--card:#16211b;--ink:#e8f1ec;--mut:#9aada3;--line:#27372f;--brand:#35c58f;--on:#06231a;--accent:#f5b83d;--warn:#f5b83d;--warnbg:#3a2c0c;--bad:#ff8a7a;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0d1511;--card:#16211b;--ink:#e8f1ec;--mut:#9aada3;--line:#27372f;--brand:#35c58f;--on:#06231a;--accent:#f5b83d;--warn:#f5b83d;--warnbg:#3a2c0c;--bad:#ff8a7a;color-scheme:dark}
*{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font:400 16px/1.4 "Jost",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-bottom:84px}
.wrap{max-width:560px;margin:0 auto;padding:0 16px}
header{padding:18px 0 8px}
header h1{margin:0;font-size:34px;font-weight:700;letter-spacing:0;line-height:1.1;display:flex;align-items:center;gap:10px}
h1,h2,h3{font-family:"Cormorant Garamond",Georgia,"Times New Roman",serif}
.logo{height:68px;width:auto;max-width:100%;object-fit:contain;display:block;background:#fff;border-radius:14px;padding:4px 10px}
header p{margin:2px 0 0;color:var(--mut);font-size:14px}
.search{width:100%;margin:10px 0 12px;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink);font:inherit}
input,select{font:inherit;color:var(--ink)}
.search:focus,.f input:focus,.f select:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px}
.chip{flex:none;border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:6px 14px;font:inherit;font-size:14px;cursor:pointer}
.chip.on{background:var(--brand);border-color:var(--brand);color:var(--on);font-weight:600}
.row{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-bottom:8px;cursor:pointer}
.em{flex:none;width:46px;height:46px;border-radius:12px;background:var(--bg);display:grid;place-items:center;font-size:26px}
.info{flex:1;min-width:0}
.info b{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.info small{color:var(--mut);font-size:13px}
.tag{display:inline-block;margin-left:6px;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;background:var(--warnbg);color:var(--warn)}
.tag.out{background:var(--bad);color:var(--card)}
.qty{display:flex;align-items:center;gap:6px}
.qty button{width:34px;height:34px;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);font-size:20px;line-height:1;cursor:pointer}
.qty span{min-width:30px;text-align:center;font-weight:800;font-size:18px}
.empty{text-align:center;color:var(--mut);padding:40px 10px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;text-align:center}
.card.sold{opacity:.5}
.card .big{font-size:44px;line-height:1.1}
.card b{display:block;margin-top:6px;font-weight:600}
.card .pr{color:var(--brand);font-weight:800;font-size:18px}
.card small{color:var(--mut)}
.btn{display:block;width:100%;text-align:center;text-decoration:none;border:0;border-radius:12px;padding:13px;font:inherit;font-weight:600;cursor:pointer;background:var(--brand);color:var(--on);margin-top:10px}
.btn.alt{background:var(--card);color:var(--ink);border:1.5px solid var(--line)}
.btn.del{background:none;color:var(--bad);margin-top:2px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
.stat small{color:var(--mut);display:block}
.stat b{font-size:24px;font-weight:800}
h2{font-size:24px;margin:18px 0 8px}
nav{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);display:flex;padding-bottom:env(safe-area-inset-bottom,0px);z-index:5}
nav button{flex:1;border:0;background:none;color:var(--mut);padding:10px 4px 8px;font:inherit;font-size:13px;cursor:pointer}
nav button span{display:block;font-size:22px}
nav button.on{color:var(--brand);font-weight:700}
.fab{position:fixed;right:16px;bottom:calc(76px + env(safe-area-inset-bottom,0px));width:56px;height:56px;border-radius:18px;border:0;background:var(--accent);color:#2a1d00;font-size:30px;font-weight:600;box-shadow:0 6px 18px rgba(0,0,0,.25);cursor:pointer;z-index:4}
.sheet-bg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10;display:none;align-items:flex-end;justify-content:center}
.sheet-bg.open{display:flex}
.sheet{background:var(--bg);width:100%;max-width:560px;max-height:92%;overflow:auto;border-radius:20px 20px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom,0px))}
.sheet h3{margin:0 0 12px;font-size:26px}
.f{display:block;margin-bottom:10px;font-size:14px;color:var(--mut)}
.f input,.f select{display:block;width:100%;margin-top:4px;padding:11px 12px;border:1.5px solid var(--line);border-radius:10px;background:var(--card)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chk{display:flex;gap:8px;align-items:center;margin:6px 0;color:var(--ink)}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(90px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:999px;font-size:14px;z-index:20;display:none}
.bar{display:flex;gap:10px;align-items:center;justify-content:space-between;background:var(--accent);color:#2a1d00;border-radius:12px;padding:10px 12px;margin-bottom:12px;font-size:14px}.bar button{border:0;border-radius:10px;padding:8px 14px;font:inherit;font-weight:700;background:#2a1d00;color:#fff;cursor:pointer}
.note{background:var(--card);border:1px dashed var(--line);border-radius:12px;padding:10px 12px;margin-bottom:10px;color:var(--mut);font-size:14px}
.card .btn{padding:9px;margin-top:8px}
.card{cursor:pointer}
.gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:16px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.gal::-webkit-scrollbar{display:none}
.gi{flex:none;width:100%;aspect-ratio:1;object-fit:cover;scroll-snap-align:center;scroll-snap-stop:always;background:#fff}
.dots{display:flex;justify-content:center;gap:7px;margin:10px 0 2px}
.dots i{width:7px;height:7px;border-radius:50%;background:var(--line);transition:background .2s,transform .2s}
.dots i.on{background:var(--brand);transform:scale(1.3)}
#splash{position:fixed;inset:0;z-index:100;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s;cursor:pointer;color:#263f65;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
#splash.out{opacity:0;pointer-events:none}
#splash .bw{animation:pop .7s ease-out both}
#splash .bee{display:block;width:170px;height:auto}
#splash .sn{font-family:"Cormorant Garamond",Georgia,serif;font-weight:700;font-size:46px;line-height:1;margin-top:14px;animation:rise .8s .35s ease-out both}
#splash .sp{font-size:13px;letter-spacing:.55em;margin:8px -.55em 0 0;font-weight:500;animation:rise .8s .6s ease-out both}
.wl,.wr{transform-box:view-box}
.wl{transform-origin:66px 52px;animation:fl .15s ease-in-out infinite alternate}
.wr{transform-origin:98px 52px;animation:fr .15s ease-in-out infinite alternate}
@keyframes fl{from{transform:rotate(-2deg)}to{transform:rotate(9deg)}}
@keyframes fr{from{transform:rotate(2deg)}to{transform:rotate(-9deg)}}
@keyframes bob{50%{transform:translateY(-6px)}}
@keyframes pop{from{opacity:0}}
@keyframes rise{from{opacity:0;transform:translateY(8px)}}
@media(prefers-reduced-motion:reduce){.wl,.wr,#splash .bee{animation:none}}
.f textarea{display:block;width:100%;margin-top:4px;padding:11px 12px;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font:inherit;min-height:96px;resize:vertical}
.dimg{width:100%;aspect-ratio:1;object-fit:cover;border-radius:16px;display:block}
.dd{white-space:pre-wrap;color:var(--mut);margin:0 0 6px}
.em{overflow:hidden}.em img{width:100%;height:100%;object-fit:cover;display:block}
.card .big img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;display:block}
.pick{display:flex;gap:12px;align-items:center;margin-bottom:12px}.pick>div:last-child{flex:1}
</style>
</head>
